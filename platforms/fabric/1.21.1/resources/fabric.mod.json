{
  "schemaVersion": 1,
  "id": "xero_quest_journal",
  "version": "${version}",
  "name": "Xero Quest Journal",
  "icon": "assets/xero_quest_journal/textures/gui/anecdote_emblem.png",
  "description": "A configurable quest journal with a native quest UI.",
  "authors": [
    "xtdpotato"
  ],
  "license": "MIT",
  "environment": "*",
  "accessWidener": "xero_quest_journal.accesswidener",
  "mixins": ["xero_quest_journal.mixins.json"],
  "entrypoints": {
    "main": [
      "xtdpotato.xero_quest_journal.fabric.XeroQuestJournalFabric"
    ],
    "client": ["xtdpotato.xero_quest_journal.fabric.XeroQuestJournalFabricClient"],
    "rei_client": ["xtdpotato.xero_quest_journal.client.QuestReiPlugin"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "fabric-api": ">=${fabric_version}"
  },
  "suggests": {
    "roughlyenoughitems": "*"
  }
}
